# -----------------------------------------------------------------------------
# INDUSTRIAL AUDIO v21 — no music tracks, no external MP3 dependency.
# The soundscape is produced by the existing AudioStreamGenerator: low machine
# hum, dull impacts, servo movement and muted threat pulses. This keeps Web and
# mobile builds deterministic and avoids unavailable audio-resource errors.
# -----------------------------------------------------------------------------

var industrial_thud_remaining_v21 := 0.0
var industrial_servo_remaining_v21 := 0.0
var industrial_noise_remaining_v21 := 0.0
var industrial_cue_strength_v21 := 0.0
var industrial_cue_phase_v21 := 0.0

func _ensure_suno_audio_v14() -> void:
	# Keep the legacy entry points so old round/story code remains compatible,
	# but deliberately do not load or play soundtrack files.
	if get_node_or_null("SunoMusic") == null:
		var music := AudioStreamPlayer.new()
		music.name = "SunoMusic"
		music.process_mode = Node.PROCESS_MODE_ALWAYS
		music.volume_db = -80.0
		add_child(music)
	if get_node_or_null("SunoChase") == null:
		var chase := AudioStreamPlayer.new()
		chase.name = "SunoChase"
		chase.process_mode = Node.PROCESS_MODE_ALWAYS
		chase.volume_db = -80.0
		add_child(chase)
	set_meta("suno_music_key", "procedural_industrial_v21")
	if audio_player:
		audio_player.volume_db = -10.0

func _load_suno_stream_v14(_path: String) -> AudioStream:
	return null

func _suno_path_v14(_key: String) -> String:
	return ""

func _round_music_key_v14() -> String:
	return "procedural_industrial_v21"

func _play_suno_music_v14(_key: String) -> void:
	set_meta("suno_music_key", "procedural_industrial_v21")

func _update_suno_audio_v14(delta: float) -> void:
	industrial_cue_phase_v21 += delta
	industrial_thud_remaining_v21 = maxf(0.0, industrial_thud_remaining_v21 - delta)
	industrial_servo_remaining_v21 = maxf(0.0, industrial_servo_remaining_v21 - delta)
	industrial_noise_remaining_v21 = maxf(0.0, industrial_noise_remaining_v21 - delta)
	industrial_cue_strength_v21 = move_toward(industrial_cue_strength_v21, 0.0, delta * 0.55)

func _industrial_audio_cue_v21(kind: String, strength := 1.0) -> void:
	industrial_cue_strength_v21 = clampf(maxf(industrial_cue_strength_v21, strength), 0.0, 1.5)
	match kind:
		"thud":
			industrial_thud_remaining_v21 = maxf(industrial_thud_remaining_v21, 0.65 + strength * 0.25)
		"servo":
			industrial_servo_remaining_v21 = maxf(industrial_servo_remaining_v21, 0.42 + strength * 0.28)
		"scrape":
			industrial_noise_remaining_v21 = maxf(industrial_noise_remaining_v21, 0.55 + strength * 0.35)
		_:
			industrial_thud_remaining_v21 = maxf(industrial_thud_remaining_v21, 0.35)
