	var frames := audio_playback.get_frames_available()
	var mix_rate := 22050.0
	var threat := 0.0
	if game_started and robots.size() > 0:
		var nearest := 999.0
		for robot in robots:
			if is_instance_valid(robot) and robot.visible:
				nearest = minf(nearest, robot.global_position.distance_to(player.global_position))
		threat = clampf(1.0 - nearest / 24.0, 0.0, 1.0)
	var round_energy := float(current_round - 1) / float(maxi(TOTAL_ROUNDS - 1, 1))
	for i in range(frames):
		var t := audio_phase + float(i) / mix_rate
		# Constant low-frequency machinery. Deliberately non-musical.
		var machine_hum := sin(t * TAU * 31.0) * 0.030
		machine_hum += sin(t * TAU * 47.0) * 0.016
		machine_hum += sin(t * TAU * 63.0) * 0.008
		var transformer := sin(t * TAU * 50.0) * 0.006 + sin(t * TAU * 100.0) * 0.003
		# Slow pressure pulse only when something is close; it stays sub-bass.
		var pulse_env := (sin(t * TAU * (0.62 + threat * 0.18)) * 0.5 + 0.5) * threat
		var threat_pulse := sin(t * TAU * (37.0 + round_energy * 7.0)) * pulse_env * 0.028
		# Dull impact cue, used for distant movement, shutters and jumpscare buildup.
		var thud := 0.0
		if industrial_thud_remaining_v21 > 0.0:
			var thud_env := clampf(industrial_thud_remaining_v21 / 0.9, 0.0, 1.0)
			thud = (sin(t * TAU * 42.0) * 0.065 + sin(t * TAU * 68.0) * 0.026) * thud_env * maxf(industrial_cue_strength_v21, 0.35)
		# Mechanical servo: low scrape plus a muted harmonic, never a bright beep.
		var servo := 0.0
		if industrial_servo_remaining_v21 > 0.0:
			var servo_env := clampf(industrial_servo_remaining_v21 / 0.7, 0.0, 1.0)
			servo = (sin(t * TAU * 118.0) * 0.020 + sin(t * TAU * 176.0) * 0.010) * servo_env * maxf(industrial_cue_strength_v21, 0.35)
		var scrape := 0.0
		if industrial_noise_remaining_v21 > 0.0:
			var scrape_env := clampf(industrial_noise_remaining_v21 / 0.9, 0.0, 1.0)
			var rough := sin(t * TAU * 613.0) * sin(t * TAU * 73.0)
			scrape = rough * 0.016 * scrape_env * maxf(industrial_cue_strength_v21, 0.35)
		var status_beep := 0.0
		if status_beep_remaining > 0.0:
			status_beep = sin(t * TAU * status_beep_frequency) * minf(status_beep_remaining * 5.0, 1.0) * 0.025
			status_beep_remaining = maxf(status_beep_remaining - 1.0 / mix_rate, 0.0)
		var sample: float = clampf(machine_hum + transformer + threat_pulse + thud + servo + scrape + status_beep, -0.18, 0.18)
		audio_playback.push_frame(Vector2(sample, sample * 0.965))
	audio_phase += float(frames) / mix_rate

func _update_hud() -> void:
	health_label.text = "SANTÉ %d%%" % int(player_health)
	if health_progress:
		health_progress.value = player_health
	if last_status_time > 0.0 and Time.get_ticks_msec() / 1000.0 - last_status_time > 5.0:
		status_label.text = ""

func _show_status(text_value: String) -> void:
	if status_label:
		status_label.text = text_value
	last_status_time = Time.get_ticks_msec() / 1000.0
	status_beep_remaining = 0.12
	status_beep_frequency = 215.0 if ("ALERTE" in text_value or "ENDOMMAG" in text_value or "ATTAQUE" in text_value or "PROXIMITY" in text_value) else 305.0
	if "BRUIT" in text_value or "MOUVEMENT" in text_value or "PROXIMITY" in text_value:
		_industrial_audio_cue_v21("thud", 0.75)
	elif "ENDOMMAG" in text_value or "ATTAQUE" in text_value or "DÉSACTIV" in text_value:
		_industrial_audio_cue_v21("servo", 0.9)
	elif "POWER" in text_value or "TENSION" in text_value:
		_industrial_audio_cue_v21("scrape", 0.55)

func _toggle_pause() -> void:
	if not game_started:
		return
	if tablet_open:
		_toggle_tablet_v12()
		return
	if context_menu_open:
		_close_context_menu_v12()
		return
	paused_from_menu = not pause_panel.visible
	get_tree().paused = paused_from_menu
	pause_panel.visible = paused_from_menu
	if paused_from_menu:
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	else:
		_capture_pointer_v13()
	if mobile_layer:
		mobile_layer.visible = not paused_from_menu

func _set_brightness(value: float) -> void:
	brightness_v20 = value
	var overlay := get_node_or_null("PS1VisualLayer/PS1PostProcess") as ColorRect
	if overlay and overlay.material is ShaderMaterial:
		(overlay.material as ShaderMaterial).set_shader_parameter("brightness", value)
	_save_display_settings_v20()

func _set_volume(value: float) -> void:
	if audio_player:
		audio_player.volume_db = value

func _toggle_fullscreen() -> void:
	if DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_FULLSCREEN:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)
	else:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)

func _quit_game() -> void:
	if OS.has_feature("web"):
		_show_status("Sur navigateur : fermez cet onglet pour quitter.")
	else:
		get_tree().quit()
