func _update_hud() -> void:
	health_label.text = "SANTÉ %d%%" % int(player_health)
	if health_progress:
		health_progress.value = player_health
	if last_status_time > 0.0 and Time.get_ticks_msec() / 1000.0 - last_status_time > 5.0:
		status_label.text = ""

func _show_status(text_value: String) -> void:
	if status_label:
		status_label.text = text_value
	last_status_time = Time.get_ticks_msec() / 1000.0
	status_beep_remaining = 0.12
	status_beep_frequency = 215.0 if ("ALERTE" in text_value or "ENDOMMAG" in text_value or "ATTAQUE" in text_value or "PROXIMITY" in text_value) else 305.0
	if "BRUIT" in text_value or "MOUVEMENT" in text_value or "PROXIMITY" in text_value:
		_industrial_audio_cue_v21("thud", 0.75)
	elif "ENDOMMAG" in text_value or "ATTAQUE" in text_value or "DÉSACTIV" in text_value:
		_industrial_audio_cue_v21("servo", 0.9)
	elif "POWER" in text_value or "TENSION" in text_value:
		_industrial_audio_cue_v21("scrape", 0.55)

func _toggle_pause() -> void:
	if not game_started:
		return
	if tablet_open:
		_toggle_tablet_v12()
		return
	if context_menu_open:
		_close_context_menu_v12()
		return
	paused_from_menu = not pause_panel.visible
	get_tree().paused = paused_from_menu
	pause_panel.visible = paused_from_menu
	if paused_from_menu:
		Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	else:
		_capture_pointer_v13()
	if mobile_layer:
		mobile_layer.visible = not paused_from_menu

func _set_brightness(value: float) -> void:
	brightness_v20 = value
	var overlay := get_node_or_null("PS1VisualLayer/PS1PostProcess") as ColorRect
	if overlay and overlay.material is ShaderMaterial:
		(overlay.material as ShaderMaterial).set_shader_parameter("brightness", value)
	_save_display_settings_v20()

func _set_volume(value: float) -> void:
	AudioServer.set_bus_volume_db(0, value)

func _toggle_fullscreen() -> void:
	if DisplayServer.window_get_mode() == DisplayServer.WINDOW_MODE_FULLSCREEN:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)
	else:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)

func _quit_game() -> void:
	if OS.has_feature("web"):
		_show_status("Sur navigateur : fermez cet onglet pour quitter.")
	else:
		get_tree().quit()
